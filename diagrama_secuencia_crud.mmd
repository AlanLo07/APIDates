```mermaid
sequenceDiagram
    actor Cliente
    participant APIGw as API Gateway
    participant Lambda as Lambda Function
    participant DDB as DynamoDB
    participant Log as CloudWatch Logs
    
    %% Caso 1: GET /challenges
    rect rgb(200, 220, 255)
        Note over Cliente,Log: Caso 1: Obtener todos los Challenges
        Cliente->>APIGw: GET /challenges?level=suave
        APIGw->>Lambda: HTTP Event
        activate Lambda
        Lambda->>Log: 🟢 Iniciando GET_ALL
        Lambda->>DDB: Scan(FilterExpression: level=suave)
        activate DDB
        DDB-->>Lambda: Items + Count
        deactivate DDB
        Lambda->>Log: 🟢 {count} items encontrados
        Lambda->>APIGw: 200 JSON Response
        deactivate Lambda
        APIGw-->>Cliente: {items, count}
    end
    
    %% Caso 2: GET /challenges/random
    rect rgb(220, 200, 255)
        Note over Cliente,Log: Caso 2: Obtener Challenge aleatorio
        Cliente->>APIGw: GET /challenges/random?level=picante
        APIGw->>Lambda: HTTP Event
        activate Lambda
        Lambda->>Log: 🟢 Iniciando GET_RANDOM
        Lambda->>DDB: Scan(FilterExpression: level=picante)
        activate DDB
        DDB-->>Lambda: All Items matching
        deactivate DDB
        Lambda->>Log: 🟢 Eligiendo aleatorio
        Lambda->>Log: 🔵 Challenge seleccionado: {id}
        Lambda->>APIGw: 200 JSON Response
        deactivate Lambda
        APIGw-->>Cliente: {id, text, emoji, level, ...}
    end
    
    %% Caso 3: POST /challenges
    rect rgb(200, 255, 200)
        Note over Cliente,Log: Caso 3: Crear nuevo Challenge
        Cliente->>APIGw: POST /challenges
        Note right of Cliente: {text, emoji, level}
        APIGw->>Lambda: HTTP Event + Body
        activate Lambda
        Lambda->>Log: 🟢 Validando campos requeridos
        
        alt Validación Exitosa
            Lambda->>Log: 🟢 Todos los campos presentes
            Lambda->>Log: 🟢 Level válido: suave
            Lambda->>Lambda: _normalize(data)
            Note right of Lambda: - UUID autogenerated<br/>- Timestamps agregados<br/>- Strings trimmed
            Lambda->>DDB: PutItem(Item)
            activate DDB
            DDB-->>Lambda: Success
            deactivate DDB
            Lambda->>Log: 🟢 Challenge creado: {id}
            Lambda->>APIGw: 201 Created
            deactivate Lambda
            APIGw-->>Cliente: {message, id}
        else Validación Falla
            Lambda->>Log: 🔴 Campo faltante: emoji
            Lambda->>APIGw: 400 Bad Request
            deactivate Lambda
            APIGw-->>Cliente: {error: "..."}
        end
    end
    
    %% Caso 4: POST /dice (Bulk)
    rect rgb(255, 240, 200)
        Note over Cliente,Log: Caso 4: Crear múltiples Dice entries
        Cliente->>APIGw: POST /dice
        Note right of Cliente: [{text, level, diceType}, ...]
        APIGw->>Lambda: HTTP Event + Array Body
        activate Lambda
        Lambda->>Log: 🟢 Detectado array de items
        Lambda->>Log: 🟢 Inicializando bulk_create
        
        loop For each item
            Lambda->>Lambda: _validate(item)
            Lambda->>Lambda: _normalize(item)
            Lambda->>DDB: batch.put_item(Item)
            activate DDB
            DDB-->>Lambda: Queued
            deactivate DDB
            Lambda->>Log: 🟢 Item validado: {id}
        end
        
        Note right of Lambda: batch_writer<br/>auto-commits
        Lambda->>Log: 🟢 3 items creados
        Lambda->>APIGw: 201 Created
        deactivate Lambda
        APIGw-->>Cliente: {message, created: [id1, id2, id3], errors: []}
    end
    
    %% Caso 5: PUT /challenges/ID
    rect rgb(255, 200, 220)
        Note over Cliente,Log: Caso 5: Actualizar Challenge
        Cliente->>APIGw: PUT /challenges/ID
        Note right of Cliente: emoji, level
        APIGw->>Lambda: HTTP Event
        activate Lambda
        Lambda->>Log: 🟢 Iniciando UPDATE
        Lambda->>Lambda: Construir UpdateExpression
        Lambda->>DDB: UpdateItem(Key, UpdateExpression)
        activate DDB
        DDB-->>Lambda: Success
        deactivate DDB
        Lambda->>Log: 🟢 Challenge actualizado
        Lambda->>APIGw: 200 OK
        deactivate Lambda
        APIGw-->>Cliente: message, id
    end
    
    %% Caso 6: DELETE /challenges/ID
    rect rgb(255, 200, 200)
        Note over Cliente,Log: Caso 6: Eliminar Challenge
        Cliente->>APIGw: DELETE /challenges/ID
        APIGw->>Lambda: HTTP Event
        activate Lambda
        Lambda->>Log: 🟢 Verificando existencia
        Lambda->>DDB: GetItem(Key)
        activate DDB
        DDB-->>Lambda: Item or empty
        deactivate DDB
        Lambda->>DDB: DeleteItem(Key)
        activate DDB
        DDB-->>Lambda: Success
        deactivate DDB
        Lambda->>Log: 🟢 Challenge eliminado
        Lambda->>APIGw: 200 OK
        deactivate Lambda
        APIGw-->>Cliente: message, id
    end
    
    %% Caso 7: Error handling
    rect rgb(255, 100, 100)
        Note over Cliente,Log: Caso 7: Error de base de datos
        Cliente->>APIGw: POST /dice
        APIGw->>Lambda: HTTP Event
        activate Lambda
        Lambda->>Log: 🟢 Validación exitosa
        Lambda->>DDB: PutItem(Item)
        activate DDB
        DDB--xLambda: ConnectionError
        deactivate DDB
        Lambda->>Log: 🔴 DynamoDB error: {error}
        Lambda->>APIGw: 502 Bad Gateway
        deactivate Lambda
        APIGw-->>Cliente: {error: "Database error"}
    end
```
